#pragma ISANN 0.1.20
# M21 - `${env.X}` reads OS env vars. `env` is a reserved namespace, so
# setting a Memory variable named `env` cannot collide with the OS lookup.
#
# Harness drives this with:
#   $env:ISANN_RECIPE_TEST_USER = "daesob"
#   isann recipe exec env.ian
#
# Expect: exit 0, captured user echoed, default fallback for unset works.

# Direct read
echo "m21 env user=${env.ISANN_RECIPE_TEST_USER}";

# Unset -> empty string (os.Getenv semantics) - use the `require` pattern
# operators will reach for when an env var is mandatory.
require ${env.ISANN_RECIPE_TEST_USER}, "ISANN_RECIPE_TEST_USER required";

# Interpolation inside a larger token
echo "m21 env interp user=[${env.ISANN_RECIPE_TEST_USER}] done";
