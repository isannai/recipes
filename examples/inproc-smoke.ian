#pragma ISANN 0.1.20
# name: inproc-smoke
# author: iSANN team
# description: Smoke test for M9 in-process dispatch + M10 set + M13 doc-string
# version: 1.0.0
#
# Each command below is registered in cmd/isann/recipe_inproc.go's
# recipeDispatch map - they run in the SAME isann process (no fork-self),
# and capture (`var := ...`) returns native Go values straight into Memory.
#
#   isann recipe exec examples/recipes/inproc-smoke.ian
#   isann recipe info examples/recipes/inproc-smoke.ian   # M13 - show meta
#
# Compare timing against fork mode:
#
#   isann recipe exec -fork examples/recipes/inproc-smoke.ian

ver := version -json;
echo "isann ${ver.isann} / isannd ${ver.isannd}";

info := info -json;
echo "node id = ${info.node_id}";

# M11 - `var` assigns a constant (no subprocess). Use it for engine names,
# timeouts, image tags etc. that you want named once and reused.
var engine = llama;
var ttl = 60s;
echo "using engine=${engine} ttl=${ttl}";

# list (multiple - exercises explicit namespace map)
list nodes -json;

echo "in-process dispatch ok";
