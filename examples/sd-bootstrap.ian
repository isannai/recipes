#pragma ISANN 0.1.20
# sd-bootstrap.ian - bring up the SD (image) service from any start state.
# Run with:  isann recipe exec examples/recipes/sd-bootstrap.ian
#
# Re-running is safe: every command is idempotent (already-installed model ->
# skip, already-running container -> noop, existing profile -> skip).

requires:
  vram: 4G+
  gpu: RTX 30 | RTX 40 | GTX 16

# Keep only the SD engine running.
docker stop --except sd;

# Pull the base model (skips if already installed).
model pull civitai://dreamshaper-8 --engine sd --kind model --arch sd15 --name dreamshaper;

# Apply a profile and (re)start the engine to pick up the .env.
profile use sd default;
docker create sd;
