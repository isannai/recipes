#pragma ISANN 0.1.20
# name: secure-unlock
# author: iSANN core
# description: prompt for the node's alias + passphrase safely, then boot the node
# version: 1.0.0
#
# When one recipe runs on several nodes the alias is usually different on each
# (daesob / alice / bob / ...). Rather than hard-coding it in plain text, ask the
# operator for it at the keyboard.
#
# Run:
#   isann recipe exec examples/recipes/secure-unlock.ian
#
# The passphrase can come from either of two places:
#   1. Set in the environment ahead of time (for scripted runs):
#        ISANN_PASSPHRASE=xxx isann recipe exec secure-unlock.ian
#      Then the `read -secret pass` line below can be omitted - `auth unlock`
#      inherits the variable from the environment.
#   2. Typed at the keyboard (interactive):
#        -secret suppresses the echo when attached to a TTY (ReadPassword).

requires:
  vram: 4G+

# Ask for the per-node alias - capture syntax (`var := func read "prompt"`).
# `func` is a reserved namespace prefix, which marks the line as a builtin.
alias := func read "account alias: ";

# Read the passphrase safely (no echo when attached to a TTY).
# pass := func read -secret "passphrase: ";

# Unlock with what was entered - nothing is hard-coded in plain text.
auth unlock --account ${alias};

# Start the node.
docker warmup;
docker wait;
docker create llama;
docker wait --engine llama --timeout 180;

echo "ready as ${alias}";
